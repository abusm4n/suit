# ---------------------------------------------------------------------------
# Raw data and local working folders. They are large, and the Mon(IoT)r traces
# are under a data-sharing agreement, so they never enter the repository (see
# README.md, "Data"). The versioned data lives in data/.
# ---------------------------------------------------------------------------
# (a leading '/' anchors a pattern at the repository root, so that for example
# data/derived/controlled/ is not caught by the rule for /controlled/)
/controlled/
/retrospective/
/dataset/
/dataset_emre/
/dataset_wustl/
/extracted/
/extracted_keywords/
/imc19_dataset/
/cvelistV5-main/
/cache/

# local notes and drafts
/doc/
/esorics/
/Technical_Report_Latex/
/Note.md
/SUIT_presentation.pptx

# ---------------------------------------------------------------------------
# Paper sources and legacy scripts stay local only.
# ---------------------------------------------------------------------------
/latex/
/legacy/

# ---------------------------------------------------------------------------
# Python, logs, editors
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
logs/
*.log
sample.json
sample.csv

# JSON files are large extraction outputs everywhere except the dated API snapshot
**/*.json
!data/reference/*.json

.DS_Store
.~lock.*#
.claude/
