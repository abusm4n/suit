Technical_Report_Latex/
# latex/: ignore build output and large figure binaries, but DO track the
# sigconf paper's sources. Note the form: 'latex/**' rather than 'latex/',
# plus '!.../**/' to re-include directories -- git will not descend into an
# excluded directory, so file-level negations alone would never match.
latex/**
!latex/suit_acm_sigconf/
!latex/suit_acm_sigconf/**/
!latex/suit_acm_sigconf/**/*.tex
!latex/suit_acm_sigconf/**/*.bib
!latex/suit_acm_sigconf/**/*.cls
!latex/suit_acm_sigconf/**/*.bst

SUIT_presentation.pptx

# --- Python ---
__pycache__/
*.pyc
.venv/

# --- Logs / scratch data ---
logs/
*.log
sample.json
sample.csv

# Ignore JSON everywhere
**/*.json

# --- Editor / OS / lock files ---
.ipynb_checkpoints/
.DS_Store
.~lock.*#


# add .gitignore to .gitignore to prevent it from being ignored
.gitignore


